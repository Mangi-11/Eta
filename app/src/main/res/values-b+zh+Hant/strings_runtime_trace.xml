    <!-- AgentPhoneToolCatalog & PersonalSearchTools -->
    <string name="tool_cat_get_flashlight_title">手電筒狀態</string>
    <string name="tool_cat_get_flashlight_desc">查詢手電筒實際狀態及是否被相機佔用。</string>
    <string name="tool_cat_set_flashlight_title">設定手電筒</string>
    <string name="tool_cat_set_flashlight_desc">開啟或關閉手電筒並透過系統回呼驗證；已處於目標狀態時不重複切換。</string>
    <string name="tool_cat_get_device_state_title">查詢系統開關</string>
    <string name="tool_cat_get_device_state_desc">查詢指定系統開關，不用 GUI。</string>
    <string name="tool_cat_get_display_state_title">顯示狀態</string>
    <string name="tool_cat_get_display_state_desc">查詢亮度、自動亮度、旋轉與自動關閉螢幕時間。</string>
    <string name="tool_cat_set_brightness_title">設定亮度</string>
    <string name="tool_cat_set_brightness_desc">依系統亮度滑桿百分比設定並讀回驗證；不支援可靠百分比介面時明確失敗。</string>
    <string name="tool_cat_set_screen_timeout_title">設定自動關閉螢幕時間</string>
    <string name="tool_cat_set_screen_timeout_desc">設定無操作後的自動關閉螢幕秒數，並讀回驗證。</string>
    <string name="tool_cat_get_sound_state_title">聲音狀態</string>
    <string name="tool_cat_get_sound_state_desc">讀取各類音量、響鈴及勿擾狀態。</string>
    <string name="tool_cat_set_sound_mode_title">設定響鈴模式</string>
    <string name="tool_cat_set_sound_mode_desc">設定正常、靜音或震動模式並驗證；一般身分可能需要勿擾存取權限。</string>
    <string name="tool_cat_set_do_not_disturb_title">設定勿擾模式</string>
    <string name="tool_cat_set_do_not_disturb_desc">直接設定勿擾原則並讀回驗證。</string>
    <string name="tool_cat_get_hotspot_title">熱點狀態</string>
    <string name="tool_cat_get_hotspot_desc">查詢網路共享熱點是否開啟；需要系統提供相容介面。</string>
    <string name="tool_cat_set_hotspot_title">設定個人熱點</string>
    <string name="tool_cat_set_hotspot_desc">使用現有熱點設定開啟或關閉網路共享，不變更名稱與密碼。</string>
    <string name="tool_cat_list_calendars_title">可用日曆</string>
    <string name="tool_cat_list_calendars_desc">列出目前使用者可寫入的日曆 ID 與名稱；建立時必須選擇真實日曆，不能猜測 calendar_id。</string>
    <string name="tool_cat_read_calendar_event_title">日程詳情</string>
    <string name="tool_cat_read_calendar_event_desc">依原始 event_id 讀取即時事件與提醒；不得使用 DMP 文件 ID。</string>
    <string name="tool_cat_create_calendar_event_title">建立日程</string>
    <string name="tool_cat_create_calendar_event_desc">直接建立日程與提醒，交易完成後讀回確認。一次性日程使用起訖時間；全天事件使用 UTC 零點與排他的結束零點。逾時後先查詢，不要重複建立。</string>
    <string name="tool_cat_create_calendar_events_title">批次建立日程</string>
    <string name="tool_cat_create_calendar_events_desc">一次建立同一日曆中的多筆日程與提醒；先校驗全部參數，再於同一交易中寫入並逐筆核對。最多 30 筆，結果未確認時先查詢，不要重複建立。</string>
    <string name="tool_cat_update_calendar_event_title">修改日程</string>
    <string name="tool_cat_update_calendar_event_desc">依原始 event_id 修改日程欄位與提醒，並讀回確認；修改時間須同時給出起訖時間。目前不修改重複事件。</string>
    <string name="tool_cat_delete_calendar_event_title">刪除日程</string>
    <string name="tool_cat_delete_calendar_event_desc">刪除精確原始 event_id；重複事件必須明確 scope=series，不能把索引 ID 當作事件 ID。</string>
    <string name="tool_cat_update_alarm_time_title">修改鬧鐘時間</string>
    <string name="tool_cat_update_alarm_time_desc">依 alarm_id 修改小時與分鐘，保留原啟用狀態並驗證。</string>
    <string name="tool_cat_set_alarm_enabled_title">鬧鐘開關</string>
    <string name="tool_cat_set_alarm_enabled_desc">啟用或關閉精確 alarm_id，讀回驗證；不依模糊時間匹配多個鬧鐘。</string>
    <string name="tool_cat_delete_alarm_title">刪除鬧鐘</string>
    <string name="tool_cat_delete_alarm_desc">刪除精確 alarm_id 後核對；不得使用 DMP 索引 ID。</string>
    <string name="tool_cat_create_note_title">建立便籤</string>
    <string name="tool_cat_create_note_desc">直接建立系統便籤，解析實際結果 UUID 並讀回；回傳未確認時不能重複建立。</string>
    <string name="tool_cat_read_note_title">便籤詳情</string>
