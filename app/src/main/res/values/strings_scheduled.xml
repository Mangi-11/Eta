    <!-- Presets -->
    <string name="scheduled_preset_evening_briefing_title">Daily evening briefing</string>
    <string name="scheduled_preset_evening_briefing_subtitle">Summarize missed important notifications, app usage, and tomorrow\'s schedule</string>
    <string name="scheduled_preset_evening_briefing_name">Daily evening briefing</string>
    <string name="scheduled_preset_evening_briefing_prompt">Prepare a concise evening briefing for today:\n1. Review today\'s important notifications and highlight items I may have missed that need follow-up (ignore ads and routine system prompts).\n2. Check tomorrow\'s calendar for key times and anything that needs preparation in advance.\n3. Briefly summarize today\'s app usage distribution (if permission is available).\nKeep the output concise enough to read on one screen, with key points first.</string>

    <string name="scheduled_preset_morning_digest_title">Weekday morning digest</string>
    <string name="scheduled_preset_morning_digest_subtitle">Morning highlights combining today\'s schedule, local weather, and tracked topics</string>
    <string name="scheduled_preset_morning_digest_name">Weekday morning digest</string>
    <string name="scheduled_preset_morning_digest_prompt">Prepare today\'s morning digest for me:\n1. Check today\'s calendar events and reminders.\n2. Look up today\'s weather for my current location or usual city, with clothing and commute tips.\n3. If my long-term memory lists ongoing projects or topics I\'m tracking, remind me of key updates.\nKeep the tone natural and concise, getting straight to the point.</string>

    <string name="scheduled_preset_web_watcher_title">Web change radar</string>
    <string name="scheduled_preset_web_watcher_subtitle">Check a web page on schedule; notify immediately on changes, stay silent otherwise</string>
    <string name="scheduled_preset_web_watcher_name">Web change radar</string>
    <string name="scheduled_preset_web_watcher_prompt">Monitor the latest updates on my target web page (replace this with the URL or topic you want to watch):\n- Read the current page content and compare it against the previous state saved in the task memo.\n- If there are no meaningful updates, call scheduled_task_report with no_change to stay silent.\n- If you spot new announcements, price changes, or status updates, update the memo and briefly report what changed.</string>

    <string name="scheduled_preset_weekly_review_title">Weekly phone &amp; habit review</string>
    <string name="scheduled_preset_weekly_review_subtitle">Sunday evening summary of weekly app time, storage usage, and memory cleanup</string>
    <string name="scheduled_preset_weekly_review_name">Weekly phone review</string>
    <string name="scheduled_preset_weekly_review_prompt">Create a lightweight weekly review for me:\n1. Summarize this week\'s app usage changes and top time-consuming apps.\n2. Check device storage space and notable large files or unusual usage (if permissions allow).\n3. Suggest 3 concrete, actionable improvements for next week.\nStick strictly to observed facts without speculation.</string>
</resources>
