    <!-- AgentPhoneToolCatalog & PersonalSearchTools -->
    <string name="tool_cat_get_flashlight_title">手电筒状态</string>
    <string name="tool_cat_get_flashlight_desc">查询手电筒实际状态及是否被相机占用。</string>
    <string name="tool_cat_set_flashlight_title">设置手电筒</string>
    <string name="tool_cat_set_flashlight_desc">开启或关闭手电筒并通过系统回调验证；已处于目标状态时不重复切换。</string>
    <string name="tool_cat_get_device_state_title">查询系统开关</string>
    <string name="tool_cat_get_device_state_desc">查询指定系统开关，不用 GUI。</string>
    <string name="tool_cat_get_display_state_title">显示状态</string>
    <string name="tool_cat_get_display_state_desc">查询亮度、自动亮度、旋转和息屏时间。</string>
    <string name="tool_cat_set_brightness_title">设置亮度</string>
    <string name="tool_cat_set_brightness_desc">按系统亮度滑块百分比设置并读回验证；不支持可靠百分比接口时明确失败。</string>
    <string name="tool_cat_set_screen_timeout_title">设置息屏时间</string>
    <string name="tool_cat_set_screen_timeout_desc">设置无操作后的自动息屏秒数，并读回验证。</string>
    <string name="tool_cat_get_sound_state_title">声音状态</string>
    <string name="tool_cat_get_sound_state_desc">读取各类音量、响铃及勿扰状态。</string>
    <string name="tool_cat_set_sound_mode_title">设置响铃模式</string>
    <string name="tool_cat_set_sound_mode_desc">设置正常、静音或振动模式并验证；普通身份可能需要勿扰访问权限。</string>
    <string name="tool_cat_set_do_not_disturb_title">设置勿扰模式</string>
    <string name="tool_cat_set_do_not_disturb_desc">直接设置勿扰策略并读回验证。</string>
    <string name="tool_cat_get_hotspot_title">热点状态</string>
    <string name="tool_cat_get_hotspot_desc">查询互联网共享热点是否开启；需要系统提供兼容接口。</string>
    <string name="tool_cat_set_hotspot_title">设置个人热点</string>
    <string name="tool_cat_set_hotspot_desc">使用现有热点配置开启或关闭网络共享，不更改名称和密码。</string>
    <string name="tool_cat_list_calendars_title">可用日历</string>
    <string name="tool_cat_list_calendars_desc">列出当前用户可写的日历 ID 和名称；创建时必须选择真实日历，不能猜 calendar_id。</string>
    <string name="tool_cat_read_calendar_event_title">日程详情</string>
    <string name="tool_cat_read_calendar_event_desc">按原始 event_id 读取实时事件与提醒；不得使用 DMP 文档 ID。</string>
    <string name="tool_cat_create_calendar_event_title">创建日程</string>
    <string name="tool_cat_create_calendar_event_desc">直接创建日程和提醒，事务完成后读回确认。一次性日程使用起止时间；全天事件使用 UTC 零点和排他的结束零点。超时后先查询，不要重复创建。</string>
    <string name="tool_cat_create_calendar_events_title">批量创建日程</string>
    <string name="tool_cat_create_calendar_events_desc">一次创建同一日历中的多条日程和提醒；先校验全部参数，再在同一事务中写入并逐条核对。最多 30 条，结果未确认时先查询，不要重复创建。</string>
    <string name="tool_cat_update_calendar_event_title">修改日程</string>
    <string name="tool_cat_update_calendar_event_desc">按原始 event_id 修改日程字段和提醒，并读回确认；修改时间须同时给出起止时间。当前不修改重复事件。</string>
    <string name="tool_cat_delete_calendar_event_title">删除日程</string>
    <string name="tool_cat_delete_calendar_event_desc">删除精确原始 event_id；重复事件必须明确 scope=series，不能把索引 ID 当作事件 ID。</string>
    <string name="tool_cat_update_alarm_time_title">修改闹钟时间</string>
    <string name="tool_cat_update_alarm_time_desc">按 alarm_id 修改小时和分钟，保留原启用状态并验证。</string>
    <string name="tool_cat_set_alarm_enabled_title">闹钟开关</string>
    <string name="tool_cat_set_alarm_enabled_desc">启用或关闭精确 alarm_id，读回验证；不按模糊时间匹配多个闹钟。</string>
    <string name="tool_cat_delete_alarm_title">删除闹钟</string>
    <string name="tool_cat_delete_alarm_desc">删除精确 alarm_id 后核对；不得使用 DMP 索引 ID。</string>
    <string name="tool_cat_create_note_title">创建便签</string>
    <string name="tool_cat_create_note_desc">直接创建系统便签，解析实际结果 UUID 并读回；返回未确认时不能重复创建。</string>
    <string name="tool_cat_read_note_title">便签详情</string>
    <string name="tool_cat_read_note_desc">按原始 note_id UUID 读取便签正文；不能使用 DMP 文档 ID。</string>
    <string name="tool_cat_delete_note_title">回收便签</string>
    <string name="tool_cat_delete_note_desc">按原始 note_id UUID 将便签移入回收站并验证，不是永久删除。</string>

    <string name="tool_cat_search_bills_title">查询账单</string>
    <string name="tool_cat_search_bills_desc">按商户、内容和时间查找账单记录。</string>
    <string name="tool_cat_search_todos_title">查询待办线索</string>
    <string name="tool_cat_search_todos_desc">查询系统从个人信息中提取的待办线索，未识别时间的记录不能按时间命中。</string>
    <string name="tool_cat_search_calendar_todos_title">查询日历待办</string>
    <string name="tool_cat_search_calendar_todos_desc">查询日历中的待办及其计划时间。</string>
    <string name="tool_cat_search_memory_collections_title">查询记忆合集</string>
    <string name="tool_cat_search_memory_collections_desc">查找已保存的记忆合集，不支持业务时间筛选。</string>
    <string name="tool_cat_search_daily_events_title">查询生活事件</string>
    <string name="tool_cat_search_daily_events_desc">查找系统记录或推断的生活事件，不把推断当成确认事实。</string>
    <string name="tool_cat_search_flights_title">查询航班行程</string>
